{
  "name": "pixel-editor",
  "private": true,
  "version": "1.0.0",
  "description": "초보자도 바로 쓸 수 있는 픽셀아트 & 애니메이션 에디터",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
