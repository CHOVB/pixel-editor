    "test:watch": "vitest",
    "codex-bridge": "node bridge/codex-bridge.mjs",
    "e2e": "playwright test",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "rust:test": "cd src-tauri/crates/codex_core && cargo test",
    "license": "node scripts/license-tool.mjs"
  },
  "dependencies": {
    "gifenc": "^1.0.3",
    "gifuct-js": "^2.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tauri-apps/cli": "^2.12.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
